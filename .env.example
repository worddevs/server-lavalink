# ==========================================
# 🔌 LAVALINK CORE SETTINGS
# ==========================================

# Internal connection port on the VPS
LAVALINK_PORT = "1234"

# Host address (00.000.000.00)
LAVALINK_ADDRESS = "0.0.0.0"

# Linked public domain
LAVALINK_HOST = "subdomain.domain.ltd"

# ==========================================
# 🔐 SECURITY & AUTHENTICATION
# ==========================================

# Password for the bot to connect
LAVALINK_PASSWORD = "your_secure_password_here"

# Secure protocol enabled (true for SSL/HTTPS/WSS, false for HTTP/WS)
LAVALINK_SECURE = "false"

# ==========================================
# 🎵 SPOTIFY API CONFIGURATION
# ==========================================

# Spotify credentials for the LavaSrc plugin
# Get yours at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID = "00000000000000000000000000000000"
SPOTIFY_CLIENT_SECRET = "00000000000000000000000000000000"
SPOTIFY_COUNTRY_CODE = "US"

# ==========================================
# 📺 YOUTUBE OAUTH2 & PROXY SETTINGS
# ==========================================

# YouTube update token / OAuth
YOUTUBE_REFRESH_TOKEN = "000000000000000000000000000000000000"

# Skip YouTube authentication initialization
YOUTUBE_SKIP_INIT = "false"

# Optional PoToken / VisitorData for anti-bot validation
YOUTUBE_PO_TOKEN = ""
YOUTUBE_VISITOR_DATA = ""

# ==========================================
# 📂 INFRASTRUCTURE & PATHS
# ==========================================

# Custom plugins folder
PLUGINS_PATH = "./Plugins"

# Folder for activity logs
LOGS_PATH = "./Logs"

# Folder for cookies persistency
COOKIES_PATH = "./Config/cookies.json"